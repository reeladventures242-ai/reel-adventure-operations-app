# Copy these values into Render environment variables or local PowerShell env vars.
# Do not commit real credentials.

# Prefer this for Supabase. Use the Supabase Postgres connection string.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Optional fallback for a non-Supabase Postgres database.
# DATABASE_URL=postgresql://user:password@host:5432/database

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://reel-adventure-operations-app.onrender.com/api/gmail/oauth/callback

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
